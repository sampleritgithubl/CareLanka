<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Emergency Icon with Soft Background -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FEF2F2"
            app:strokeWidth="0dp">
            <TextView
                android:id="@+id/tvEmergencyIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🚑"
                android:textSize="28sp"/>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvEmergencyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suwa Seriya"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#1E293B"
                android:letterSpacing="-0.01"/>

            <TextView
                android:id="@+id/tvEmergencyNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1990"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"/>
        </LinearLayout>

        <!-- Call Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallNow"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:text="CALL"
            android:textColor="#EF4444"
            android:fontFamily="sans-serif-black"
            app:backgroundTint="#FEE2E2"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_call"
            app:iconTint="#EF4444"
            android:paddingHorizontal="16dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
